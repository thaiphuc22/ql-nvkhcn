# @khcn-core/* khai peer @angular/core: "21.2.5" CHÍNH XÁC một bản, repo chạy dải ^21.2.0.
# Không sửa package.json của package vendor (D23) — nới ràng buộc ở đây thay vì sửa thứ mình không sở hữu.
legacy-peer-deps=true

# BẮT BUỘC. Mặc định npm cài dep `file:` bằng SYMLINK ⇒ esbuild phân giải theo đường dẫn thật
# (`UI-ubck/.../package/`), nơi không có `node_modules`, và mọi import trần bên trong package vendor
# (`@angular/core`, `primeng/base`) đều "Could not resolve". `install-links` bảo npm CHÉP package vào
# `node_modules` như dep bình thường ⇒ phân giải ngược lên `frontend-angular/node_modules` là thấy.
# Đã kiểm chứng 2026-08-26: bỏ dòng này thì `ng build` đỏ ngay ở dòng import đầu tiên của theme.
install-links=true
