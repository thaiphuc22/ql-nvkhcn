<?xml version="1.0" encoding="UTF-8"?>
<!-- RD02.02 — Xét duyệt nhiệm vụ KHCN cấp Tập đoàn. Dựng từ RD02_02_Gan_Bieu_mau.md. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  id="Definitions_RD02_02" targetNamespace="http://vht.vn/qtkhcn/bpmn">
  <bpmn:collaboration id="Collaboration_RD02_02">
    <bpmn:participant id="Participant_RD02_02" name="RD02.02 — Xét duyệt NV KHCN cấp Tập đoàn" processRef="RD02_02" />
  </bpmn:collaboration>
  <bpmn:process id="RD02_02" name="Xét duyệt NV KHCN cấp Tập đoàn" isExecutable="true">
    <bpmn:extensionElements>
      <!-- Action Studio contract: every RD02.02 user task exposes the two runtime decisions.
           Keeping this beside the executable process makes scaffold/reconcile deterministic and
           removes the need for process-level policy repair migrations. -->
      <zeebe:properties>
        <zeebe:property name="qtkhcn.contractVersion" value="v3" />
        <zeebe:property name="qtkhcn.userTaskActions" value="APPROVE_STEP,REJECT_STEP" />
      </zeebe:properties>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_RD02_02">
      <bpmn:lane id="Lane_PM" name="PM / PA / NNC">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>T01</bpmn:flowNodeRef><bpmn:flowNodeRef>T02</bpmn:flowNodeRef><bpmn:flowNodeRef>Check</bpmn:flowNodeRef><bpmn:flowNodeRef>GCheck</bpmn:flowNodeRef><bpmn:flowNodeRef>G03Split</bpmn:flowNodeRef><bpmn:flowNodeRef>G03Join</bpmn:flowNodeRef><bpmn:flowNodeRef>T03_PM</bpmn:flowNodeRef><bpmn:flowNodeRef>T08</bpmn:flowNodeRef><bpmn:flowNodeRef>T11</bpmn:flowNodeRef><bpmn:flowNodeRef>T16</bpmn:flowNodeRef><bpmn:flowNodeRef>T22</bpmn:flowNodeRef><bpmn:flowNodeRef>T25</bpmn:flowNodeRef><bpmn:flowNodeRef>G09Split</bpmn:flowNodeRef><bpmn:flowNodeRef>G09Join</bpmn:flowNodeRef><bpmn:flowNodeRef>G12Split</bpmn:flowNodeRef><bpmn:flowNodeRef>G12Join</bpmn:flowNodeRef><bpmn:flowNodeRef>G23Split</bpmn:flowNodeRef><bpmn:flowNodeRef>G23Join</bpmn:flowNodeRef><bpmn:flowNodeRef>G26Split</bpmn:flowNodeRef><bpmn:flowNodeRef>G26Join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Pool_CQ_KHCN" name="CQ_KHCN"><bpmn:flowNodeRef>T03_CQ_KHCN</bpmn:flowNodeRef><bpmn:flowNodeRef>T09_CQ_KHCN</bpmn:flowNodeRef><bpmn:flowNodeRef>T12_CQ_KHCN</bpmn:flowNodeRef><bpmn:flowNodeRef>T23_CQ_KHCN</bpmn:flowNodeRef><bpmn:flowNodeRef>T26_CQ_KHCN</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Pool_CQ_MS" name="CQ_MS"><bpmn:flowNodeRef>T03_CQ_MS</bpmn:flowNodeRef><bpmn:flowNodeRef>T09_CQ_MS</bpmn:flowNodeRef><bpmn:flowNodeRef>T12_CQ_MS</bpmn:flowNodeRef><bpmn:flowNodeRef>T23_CQ_MS</bpmn:flowNodeRef><bpmn:flowNodeRef>T26_CQ_MS</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Pool_CQ_TCKT" name="CQ_TCKT"><bpmn:flowNodeRef>T03_CQ_TCKT</bpmn:flowNodeRef><bpmn:flowNodeRef>T09_CQ_TCKT</bpmn:flowNodeRef><bpmn:flowNodeRef>T12_CQ_TCKT</bpmn:flowNodeRef><bpmn:flowNodeRef>T23_CQ_TCKT</bpmn:flowNodeRef><bpmn:flowNodeRef>T26_CQ_TCKT</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Pool_CQ_NS" name="CQ_NS"><bpmn:flowNodeRef>T03_CQ_NS</bpmn:flowNodeRef><bpmn:flowNodeRef>T09_CQ_NS</bpmn:flowNodeRef><bpmn:flowNodeRef>T12_CQ_NS</bpmn:flowNodeRef><bpmn:flowNodeRef>T23_CQ_NS</bpmn:flowNodeRef><bpmn:flowNodeRef>T26_CQ_NS</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Pool_TP_CLKHCN" name="TP_CLKHCN"><bpmn:flowNodeRef>T14_TP_CLKHCN</bpmn:flowNodeRef><bpmn:flowNodeRef>T28_TP_CLKHCN</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Pool_GD_TTMS" name="GD_TTMS"><bpmn:flowNodeRef>T14_GD_TTMS</bpmn:flowNodeRef><bpmn:flowNodeRef>T28_GD_TTMS</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Pool_TP_NS" name="TP_NS"><bpmn:flowNodeRef>T14_TP_NS</bpmn:flowNodeRef><bpmn:flowNodeRef>T28_TP_NS</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Pool_TP_TCKT" name="TP_TCKT"><bpmn:flowNodeRef>T14_TP_TCKT</bpmn:flowNodeRef><bpmn:flowNodeRef>T28_TP_TCKT</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_BGD" name="BGĐ Trung tâm / BGĐ Khối">
        <bpmn:flowNodeRef>T04</bpmn:flowNodeRef><bpmn:flowNodeRef>T13</bpmn:flowNodeRef><bpmn:flowNodeRef>T27</bpmn:flowNodeRef><bpmn:flowNodeRef>G14Split</bpmn:flowNodeRef><bpmn:flowNodeRef>G14Join</bpmn:flowNodeRef><bpmn:flowNodeRef>G28Split</bpmn:flowNodeRef><bpmn:flowNodeRef>G28Join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CQQL" name="Cơ quan QL KHCN VHT">
        <bpmn:flowNodeRef>T05</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HDXD_CS" name="HĐXD cấp Cơ sở">
        <bpmn:flowNodeRef>T07</bpmn:flowNodeRef><bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LDVHT" name="Lãnh đạo VHT / CQNV VHT">
        <bpmn:flowNodeRef>T06</bpmn:flowNodeRef><bpmn:flowNodeRef>Generate_HDXD</bpmn:flowNodeRef><bpmn:flowNodeRef>T15</bpmn:flowNodeRef><bpmn:flowNodeRef>T29</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TD" name="CQ KHCN TĐ / HĐXD TĐ / HĐ KHCN TĐ">
        <bpmn:flowNodeRef>T17</bpmn:flowNodeRef><bpmn:flowNodeRef>G18Split</bpmn:flowNodeRef><bpmn:flowNodeRef>T18A</bpmn:flowNodeRef><bpmn:flowNodeRef>T18B</bpmn:flowNodeRef><bpmn:flowNodeRef>G18Join</bpmn:flowNodeRef><bpmn:flowNodeRef>T19</bpmn:flowNodeRef><bpmn:flowNodeRef>Generate_HDXD_TD</bpmn:flowNodeRef><bpmn:flowNodeRef>T21</bpmn:flowNodeRef><bpmn:flowNodeRef>T24</bpmn:flowNodeRef><bpmn:flowNodeRef>Load_HDXD_TD</bpmn:flowNodeRef><bpmn:flowNodeRef>Tinh_DiemTB_T24</bpmn:flowNodeRef><bpmn:flowNodeRef>Rule_DanhGiaT24</bpmn:flowNodeRef><bpmn:flowNodeRef>G24</bpmn:flowNodeRef><bpmn:flowNodeRef>End_KhongThongQua</bpmn:flowNodeRef><bpmn:flowNodeRef>T30</bpmn:flowNodeRef><bpmn:flowNodeRef>T31</bpmn:flowNodeRef><bpmn:flowNodeRef>T32</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BTGD" name="Ban Tổng Giám đốc Tập đoàn">
        <bpmn:flowNodeRef>T20</bpmn:flowNodeRef><bpmn:flowNodeRef>T33</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start" name="Có QĐ phê duyệt chủ trương cấp TĐ"><bpmn:outgoing>F01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="T01" name="1. Khởi tạo luồng xét duyệt cấp Tập đoàn RD02.02"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="PM" /><zeebe:formDefinition formKey="bm-02-01-dki-nv" /></bpmn:extensionElements><bpmn:incoming>F01</bpmn:incoming><bpmn:outgoing>F02</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T02" name="2. Xây dựng dự thảo HS đề nghị xét duyệt (HSXD dự thảo 1)"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="PM,PA,NNC" /><zeebe:formDefinition formKey="bm-02-02-dto-nv" /></bpmn:extensionElements><bpmn:incoming>F02</bpmn:incoming><bpmn:incoming>FCheckFail</bpmn:incoming><bpmn:outgoing>F03</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Check" name="Hệ thống kiểm tra điều kiện, nội dung, thể thức và nhân sự thẩm định"><bpmn:extensionElements><zeebe:taskDefinition type="khcn.rd0202.check-default-condition" retries="3" /></bpmn:extensionElements><bpmn:incoming>F03</bpmn:incoming><bpmn:outgoing>F04</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GCheck" name="Hồ sơ đủ điều kiện?" default="FCheckFail"><bpmn:incoming>F04</bpmn:incoming><bpmn:outgoing>FCheckOK</bpmn:outgoing><bpmn:outgoing>FCheckFail</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="G03Split" name="Phân công thẩm định song song"><bpmn:incoming>FCheckOK</bpmn:incoming><bpmn:outgoing>F03KHCN</bpmn:outgoing><bpmn:outgoing>F03MS</bpmn:outgoing><bpmn:outgoing>F03TCKT</bpmn:outgoing><bpmn:outgoing>F03NS</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="T03_CQ_KHCN" name="3. Thẩm định chuyên môn và hoàn chỉnh HSXD dự thảo 2"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="CQ_KHCN" /><zeebe:formDefinition formKey="bm-02-09-pnx-dt" /></bpmn:extensionElements><bpmn:incoming>F03KHCN</bpmn:incoming><bpmn:outgoing>F03KHCN_DONE</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T03_CQ_MS" name="3. Thẩm định chuyên môn và hoàn chỉnh HSXD dự thảo 2"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="CQ_MS" /><zeebe:formDefinition formKey="bm-02-09-pnx-dt" /></bpmn:extensionElements><bpmn:incoming>F03MS</bpmn:incoming><bpmn:outgoing>F03MS_DONE</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T03_CQ_TCKT" name="3. Thẩm định chuyên môn và hoàn chỉnh HSXD dự thảo 2"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="CQ_TCKT" /><zeebe:formDefinition formKey="bm-02-09-pnx-dt" /></bpmn:extensionElements><bpmn:incoming>F03TCKT</bpmn:incoming><bpmn:outgoing>F03TCKT_DONE</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T03_CQ_NS" name="3. Thẩm định chuyên môn và hoàn chỉnh HSXD dự thảo 2"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="CQ_NS" /><zeebe:formDefinition formKey="bm-02-09-pnx-dt" /></bpmn:extensionElements><bpmn:incoming>F03NS</bpmn:incoming><bpmn:outgoing>F03NS_DONE</bpmn:outgoing></bpmn:userTask>
    <bpmn:parallelGateway id="G03Join" name="Hoàn tất thẩm định chuyên môn"><bpmn:incoming>F03KHCN_DONE</bpmn:incoming><bpmn:incoming>F03MS_DONE</bpmn:incoming><bpmn:incoming>F03TCKT_DONE</bpmn:incoming><bpmn:incoming>F03NS_DONE</bpmn:incoming><bpmn:outgoing>F05</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="T03_PM" name="3. Nhận PNX và hoàn chỉnh HSXD"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="PM" /><zeebe:formDefinition formKey="phieu-phe-duyet" /></bpmn:extensionElements><bpmn:incoming>F05</bpmn:incoming><bpmn:outgoing>F05B</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T04" name="4. Ký hồ sơ dự thảo đề nghị xét duyệt"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="BGD_TT,BGD_KHOI" /><zeebe:formDefinition formKey="phieu-phe-duyet" /></bpmn:extensionElements><bpmn:incoming>F05B</bpmn:incoming><bpmn:outgoing>F06</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T05" name="5. Lập, trình QĐ thành lập HĐXD cấp Cơ sở"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="CQ_QLKHCN" /><zeebe:formDefinition formKey="bm-02-08-qdh-nv" /></bpmn:extensionElements><bpmn:incoming>F06</bpmn:incoming><bpmn:outgoing>F07</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T06" name="6. Phê duyệt QĐ thành lập HĐXD cấp Cơ sở"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="TGD_VHT" /><zeebe:formDefinition formKey="phieu-phe-duyet" /></bpmn:extensionElements><bpmn:incoming>F07</bpmn:incoming><bpmn:outgoing>F08</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Generate_HDXD" name="Hệ thống sinh Hội đồng xét duyệt cấp Cơ sở"><bpmn:extensionElements><zeebe:taskDefinition type="khcn.rd0202.generate-hdxd-decision" retries="3" /></bpmn:extensionElements><bpmn:incoming>F08</bpmn:incoming><bpmn:outgoing>F08B</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="T07" name="7. Họp HĐXD cấp Cơ sở phiên 1"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="HDXD" /><zeebe:formDefinition formKey="bm-02-09-pnx-dt" /></bpmn:extensionElements><bpmn:incoming>F08B</bpmn:incoming><bpmn:outgoing>F09</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T08" name="8. Hoàn thiện HSXD dự thảo 3 theo phiên 1"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="PM,PA,NNC" /><zeebe:formDefinition formKey="bm-02-16-bca-nv" /></bpmn:extensionElements><bpmn:incoming>F09</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:userTask>
    <bpmn:parallelGateway id="G09Split" name="Phân công rà soát song song"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F_T09_CQ_KHCN</bpmn:outgoing><bpmn:outgoing>F_T09_CQ_MS</bpmn:outgoing><bpmn:outgoing>F_T09_CQ_TCKT</bpmn:outgoing><bpmn:outgoing>F_T09_CQ_NS</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="T09_CQ_KHCN" name="9. Rà soát HSXD dự thảo 3"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="CQ_KHCN" /><zeebe:formDefinition formKey="phieu-dat-chua-dat" /></bpmn:extensionElements><bpmn:incoming>F_T09_CQ_KHCN</bpmn:incoming><bpmn:outgoing>F_T09_CQ_KHCN_DONE</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T09_CQ_MS" name="9. Rà soát HSXD dự thảo 3"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="CQ_MS" /><zeebe:formDefinition formKey="phieu-dat-chua-dat" /></bpmn:extensionElements><bpmn:incoming>F_T09_CQ_MS</bpmn:incoming><bpmn:outgoing>F_T09_CQ_MS_DONE</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T09_CQ_TCKT" name="9. Rà soát HSXD dự thảo 3"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="CQ_TCKT" /><zeebe:formDefinition formKey="phieu-dat-chua-dat" /></bpmn:extensionElements><bpmn:incoming>F_T09_CQ_TCKT</bpmn:incoming><bpmn:outgoing>F_T09_CQ_TCKT_DONE</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T09_CQ_NS" name="9. Rà soát HSXD dự thảo 3"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="CQ_NS" /><zeebe:formDefinition formKey="phieu-dat-chua-dat" /></bpmn:extensionElements><bpmn:incoming>F_T09_CQ_NS</bpmn:incoming><bpmn:outgoing>F_T09_CQ_NS_DONE</bpmn:outgoing></bpmn:userTask>
    <bpmn:parallelGateway id="G09Join" name="Hoàn tất rà soát dự thảo 3"><bpmn:incoming>F_T09_CQ_KHCN_DONE</bpmn:incoming><bpmn:incoming>F_T09_CQ_MS_DONE</bpmn:incoming><bpmn:incoming>F_T09_CQ_TCKT_DONE</bpmn:incoming><bpmn:incoming>F_T09_CQ_NS_DONE</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:parallelGateway>
    
    <bpmn:userTask id="T10" name="10. Họp HĐXD cấp Cơ sở phiên 2"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="HDXD" /><zeebe:formDefinition formKey="bm-02-12-pdg-dt" /></bpmn:extensionElements><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T11" name="11. Cập nhật và trình ký CV đề nghị xét duyệt cấp TĐ"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="PM,PA,NNC" /><zeebe:formDefinition formKey="bm-02-00-cv-dk-xd-nv" /></bpmn:extensionElements><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:userTask>
    <bpmn:parallelGateway id="G12Split" name="Phân công ký rà soát song song"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F_T12_CQ_KHCN</bpmn:outgoing><bpmn:outgoing>F_T12_CQ_MS</bpmn:outgoing><bpmn:outgoing>F_T12_CQ_TCKT</bpmn:outgoing><bpmn:outgoing>F_T12_CQ_NS</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="T12_CQ_KHCN" name="12. Ký rà soát HSXD"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="CQ_KHCN" /><zeebe:formDefinition formKey="phieu-dat-chua-dat" /></bpmn:extensionElements><bpmn:incoming>F_T12_CQ_KHCN</bpmn:incoming><bpmn:outgoing>F_T12_CQ_KHCN_DONE</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T12_CQ_MS" name="12. Ký rà soát HSXD"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="CQ_MS" /><zeebe:formDefinition formKey="phieu-dat-chua-dat" /></bpmn:extensionElements><bpmn:incoming>F_T12_CQ_MS</bpmn:incoming><bpmn:outgoing>F_T12_CQ_MS_DONE</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T12_CQ_TCKT" name="12. Ký rà soát HSXD"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="CQ_TCKT" /><zeebe:formDefinition formKey="phieu-dat-chua-dat" /></bpmn:extensionElements><bpmn:incoming>F_T12_CQ_TCKT</bpmn:incoming><bpmn:outgoing>F_T12_CQ_TCKT_DONE</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T12_CQ_NS" name="12. Ký rà soát HSXD"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="CQ_NS" /><zeebe:formDefinition formKey="phieu-dat-chua-dat" /></bpmn:extensionElements><bpmn:incoming>F_T12_CQ_NS</bpmn:incoming><bpmn:outgoing>F_T12_CQ_NS_DONE</bpmn:outgoing></bpmn:userTask>
    <bpmn:parallelGateway id="G12Join" name="Hoàn tất ký rà soát"><bpmn:incoming>F_T12_CQ_KHCN_DONE</bpmn:incoming><bpmn:incoming>F_T12_CQ_MS_DONE</bpmn:incoming><bpmn:incoming>F_T12_CQ_TCKT_DONE</bpmn:incoming><bpmn:incoming>F_T12_CQ_NS_DONE</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:parallelGateway>
    
    <bpmn:userTask id="T13" name="13. Ký duyệt HSXD tại Trung tâm/Khối"><bpmn:extensionElements><zeebe:assignmentDefinition candidateGroups="BGD_TT,BGD_KHOI" /><zeebe:formDefinition formKey="phieu-phe-duyet" /></bpmn:extensionElements><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:userTask>
    <bpmn:parallelGateway id="G14Split" name="Phân công ký duyệt CV song song"><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F_T14_TP_CLKHCN</bpmn:outgoing><bpmn:outgoing>F_T14_GD_TTMS</bpmn:outgoing><bpmn:outgoing>F_T14_TP_NS</bpmn:outgoing><bpmn:outgoing>F_T14_TP_TCKT</bpmn:outgoing></bpmn:parallelGateway>
