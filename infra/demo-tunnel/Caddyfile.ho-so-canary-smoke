{
	# Separate admin endpoint so this short-lived smoke proxy cannot replace the live Caddy config.
	admin 127.0.0.1:2020
}

http://127.0.0.1:8444 {
	bind 127.0.0.1

	@ho_so_reads {
		method GET
		path /api/ho-so /api/ho-so/* /api/nhiem-vu /api/nhiem-vu/*
	}
	handle @ho_so_reads {
		reverse_proxy 127.0.0.1:8093 {
			header_up Authorization "Bearer {$QTKHCN_HO_SO_SERVICE_TOKEN}"
		}
	}

	# Mutations and every API outside the read-only seam stay on the monolith.
	handle /api/* {
		reverse_proxy 127.0.0.1:8090 {
			header_up X-QTKHCN-Dev-Key {$QTKHCN_DEV_API_KEY}
		}
	}

	handle {
		root * {$DEMO_STATIC_ROOT}
		try_files {path} /index.html
		file_server
	}
}
