<?xml version="1.0" encoding="UTF-8"?>
<!--
  STUB BPMN — RD05.01 Nghiệm thu NV KHCN cấp Cơ sở
  Sinh tự động 2026-09-29.
  Linear user-task skeleton + candidateGroups tạm (khảo sát BA).
  KHÔNG phải bản baseline ký duyệt / production. Import thủ công vào Zeebe khi sẵn sàng.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  id="Definitions_RD05_01" targetNamespace="http://vht.vn/qtkhcn/bpmn/stubs">
  <bpmn:process id="RD05_01" name="Nghiệm thu NV KHCN cấp Cơ sở" isExecutable="true">
    <bpmn:startEvent id="Start_RD05_01" name="Bắt đầu">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_1" name="1. PM lập &amp; trình HS nghiệm thu">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="PM" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_2" name="2. BGĐ ký duyệt HS">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="BGD_TT" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_3" name="3. CQ lập QĐ TL HĐNT">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="CQ_KHCN" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_4" name="4. HĐNT đánh giá phiên 1–2">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="HDNT" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_5" name="5. TGĐ phê duyệt QĐ công nhận KQ">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="TGD" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_RD05_01" name="Kết thúc">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start_RD05_01" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_4" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_5" targetRef="End_RD05_01" />
  </bpmn:process>
</bpmn:definitions>
