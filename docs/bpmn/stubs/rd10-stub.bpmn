<?xml version="1.0" encoding="UTF-8"?>
<!--
  STUB BPMN — RD10 Khai báo cấu hình lưu trữ tài liệu
  Sinh tự động 2026-09-29.
  Linear user-task skeleton + candidateGroups tạm (khảo sát BA).
  KHÔNG phải bản baseline ký duyệt / production. Import thủ công vào Zeebe khi sẵn sàng.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  id="Definitions_RD10" targetNamespace="http://vht.vn/qtkhcn/bpmn/stubs">
  <bpmn:process id="RD10" name="Khai báo cấu hình lưu trữ tài liệu" isExecutable="true">
    <bpmn:startEvent id="Start_RD10" name="Bắt đầu">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_1" name="1. PM lập phiếu PYC">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="PM" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_2" name="2. BGĐ TT thẩm định">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="BGD_TT" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_3" name="3. BGĐ Khối phê duyệt">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="BGD_KHOI" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_4" name="4. P.CNTT khai báo phân vùng">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="CNTT" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_RD10" name="Kết thúc">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start_RD10" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_4" targetRef="End_RD10" />
  </bpmn:process>
</bpmn:definitions>
